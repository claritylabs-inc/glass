# Spot iMessage worker local development template.
# Copy to .env.local and fill in live dev values.
#
# Run with either:
#   set -a; source .env.local; set +a; npm run dev:terminal
# or:
#   npm run build && node --env-file=.env.local dist/index.js

# Dev terminal TUI transport. Keep real Photon iMessage disabled in dev.
SPOT_ENV=local
# `customer` keeps the existing client iMessage lane. Use `operator` only for
# the separate internal Photon project/number and operator Convex endpoints.
IMESSAGE_CHANNEL_ROLE=customer
IMESSAGE_ENABLED=false
SPECTRUM_PROVIDER=terminal

# Convex dev HTTP actions URL.
CONVEX_SITE_URL=https://your-dev-deployment.convex.site

# Must match IMESSAGE_WORKER_SECRET in the Convex dev environment.
IMESSAGE_WORKER_SECRET=change-me

# Must match a Spot user phone in Convex dev so inbound messages can route.
IMESSAGE_TERMINAL_FROM_PHONE=+12025550123
# Optional aliases used by /as in the terminal TUI. The client phone must match
# a seeded Spot user; the public phone intentionally must not match a user.
IMESSAGE_TERMINAL_BROKER_PHONE=+12025550123
IMESSAGE_TERMINAL_CLIENT_PHONE=+12025550102
IMESSAGE_TERMINAL_PUBLIC_PHONE=+12025550199
IMESSAGE_TERMINAL_SPACE_ID=chat-1

# Local outbound HTTP server used by Convex status-cue sends.
WORKER_HTTP_PORT=3001

# Required only for SPECTRUM_PROVIDER=imessage / production-like real iMessage.
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=

# Separate internal operator lane. These values are intentionally not aliases
# for the customer credentials above. Set them only on the second worker
# service together with IMESSAGE_CHANNEL_ROLE=operator.
OPERATOR_IMESSAGE_ENABLED=false
OPERATOR_IMESSAGE_TERMINAL_ENABLED=false
OPERATOR_IMESSAGE_WORKER_SECRET=
OPERATOR_IMESSAGE_TERMINAL_FROM_PHONE=+12025550100
OPERATOR_IMESSAGE_TERMINAL_SPACE_ID=operator-chat-1
OPERATOR_PHOTON_PROJECT_ID=
OPERATOR_PHOTON_PROJECT_SECRET=
